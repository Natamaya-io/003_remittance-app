APP_NAME="Fable RemitOps"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/AplikasiRemmitance/public
APP_TIMEZONE=Asia/Jakarta
APP_KEY=replace-with-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=AplikasiRemmitance
DB_USERNAME=root
DB_PASSWORD=

# Provider resmi: Kurs Transaksi Bank Indonesia (harian)
FX_PROVIDER=bank-indonesia
FX_API_KEY=
FX_BASE=IDR
FX_QUOTES=USD,EUR,SGD,AUD,GBP,JPY,CNY,HKD,MYR,THB,KRW,CHF,CAD,NZD,SAR,AED
FX_CACHE_MINUTES=60
FX_SPREAD_PERCENT=0.25

UPLOAD_MAX_MB=20
